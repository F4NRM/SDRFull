# Line endings: LF in the repository AND in every checkout, on every OS.
# `eol=lf` wins over a contributor's `core.autocrlf`, so a CRLF written by an
# editor on Windows is turned back into LF when the file is added, and a
# checkout never writes CRLF. The `line-endings` workflow refuses a CRLF that
# still gets through.
* text=auto eol=lf

# Binary files: never touched.
